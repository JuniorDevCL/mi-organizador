# ── Backend ────────────────────────────────────────────────────────────────
# Puerto local del servidor Express
PORT=3000
# Clave para firmar los tokens de sesión (obligatoria en Vercel)
JWT_SECRET=cambia-esta-clave
# Postgres. En Vercel: Storage → Neon (o pega DATABASE_URL).
# Si no existe en local, se usa SQLite en server/data/app.db
# DATABASE_URL=postgres://user:pass@host:5432/db
# Neon verifica el certificado. Solo si el motor se queja: DATABASE_SSL_INSECURE=1
# Correos que pueden ver quién se unió (Config → Personas que se unieron).
# Separa varios con coma. Usa el mismo correo con el que entras a la app.
# ADMIN_EMAILS=tu@mail.udp.cl
# Dominios que pueden entrar. Por defecto: udp.cl (incluye @mail.udp.cl).
# ALLOWED_EMAIL_DOMAINS=udp.cl
# OAuth de Google para entrar (el mismo cliente puede servir para Calendar).
# GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=el-secreto-del-cliente-web
# PUBLIC_URL=https://tu-app.vercel.app

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Google Calendar (opcional). Debe definirse en tiempo de build.
# VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
