# ── Backend ────────────────────────────────────────────────────────────────
# Puerto local del servidor Express
PORT=3000
# Clave para firmar los tokens de sesión (en Render se genera sola)
JWT_SECRET=cambia-esta-clave
# Postgres (Render la inyecta). Si no existe, se usa SQLite en server/data/app.db
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Google Calendar (opcional). Debe definirse en tiempo de build.
# VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
